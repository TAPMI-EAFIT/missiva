# Template. Examples load examples/.env (same keys). Copy or edit that file.
#
# Do not reuse one CLIENT_ID across two live processes. MQTT 3.1.1 disconnects
# the older connection. Leave it unset to generate a unique id per process.

MISSIVA_BROKER_HOST=localhost
MISSIVA_BROKER_PORT=1883
MISSIVA_BROKER_USERNAME=lorem
MISSIVA_BROKER_PASSWORD=ipsum
# MISSIVA_BROKER_CLIENT_ID=missiva-example
MISSIVA_BROKER_RECONNECT_MAX_ATTEMPTS=10
MISSIVA_BROKER_RECONNECT_DELAY_SECONDS=5.0
